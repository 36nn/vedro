# Пример переменных окружения backend.
# Скопируйте этот файл в backend/.env и заполните значения.
# Файл .env не попадает в Git (см. .gitignore).
# ВНИМАНИЕ: настоящие ключи указывайте только в backend/.env, не здесь!

# Ключ YouTube Data API v3.
# Как получить: https://console.cloud.google.com/ → включить YouTube Data API v3
# → APIs & Services → Credentials → Create credentials → API key.
YOUTUBE_API_KEY=your_api_key_here

# Дополнительные ключи через запятую — суточные квоты всех ключей
# складываются, ключи используются по кругу: если у одного квота
# кончилась, автоматически берётся следующий.
# YOUTUBE_API_KEYS=второй_ключ,третий_ключ

# --- База данных PostgreSQL ---
# Формат: postgresql+psycopg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ
DATABASE_URL=postgresql+psycopg://postgres:your_db_password@127.0.0.1:5432/vedro

# --- JWT ---
# Секрет подписи токенов. Сгенерируйте свой уникальный (не используйте этот!):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_secret
JWT_ALGORITHM=HS256
# Срок жизни access-токена в минутах (1440 = 24 часа)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Email (Resend) ---
# API-ключ из https://resend.com/api-keys (создать свой)
RESEND_API_KEY=re_your_api_key_here
# От кого письма. Дефолт onboarding@resend.dev шлёт только на email
# ВАШЕГО аккаунта Resend; для любых адресов подключите свой домен.
EMAIL_FROM=Vedro <onboarding@resend.dev>
# База адресов фронта — из неё строится ссылка подтверждения в письме
APP_BASE_URL=http://localhost:5173
# Срок действия ссылки подтверждения, минут
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
# DEV-режим: письма не шлются, ссылка подтверждения показывается на сайте
# (для локальных тестов с любыми email). В production — false!
EMAIL_DEV_MODE=false

# --- CORS (production) ---
# Адреса фронтенда через запятую, например адрес Render:
# FRONTEND_ORIGINS=https://vedro-frontend.onrender.com

# --- Миграции ---
# true = применять миграции Alembic при каждом старте backend (нужно на Render)
AUTO_MIGRATE=true

APP_NAME=Random Video
HOST=127.0.0.1
PORT=8000
